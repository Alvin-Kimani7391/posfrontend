{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/rider/:token",
      "destination": "/rider.html"
    },
    {
      "source": "/track/:token/:key",
      "destination": "/track.html"
    },
    {
      "source": "/kiosk/:token",
      "destination": "/kiosk.html"
    },
    {
      "source": "/q/:token(b_.*)",
      "destination": "/store.html"
    },
    {
      "source": "/s/:token",
      "destination": "/store.html"
    },
    {
      "source": "/q/:token",
      "destination": "/q.html"
    }
  ]
}